{
  "name": "@figtools/cli",
  "version": "0.1.0",
  "description": "Resolves one or more Figma URLs from the command line and writes the result as JSON or as a navigable markdown tree meant to be used as a data source by an LLM.",
  "keywords": ["figma", "figma-api", "cli", "scraper", "markdown", "llm"],
  "homepage": "https://github.com/dryor/figtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dryor/figtools.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dryor/figtools/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "figtools": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "rslib build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@figtools/core": "workspace:*",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
