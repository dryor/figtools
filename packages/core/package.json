{
  "name": "@figtools/core",
  "version": "0.2.0",
  "description": "Fetches the data of a Figma node or file (position, size, styles, hierarchy) without the limitations of a free account: no official REST API rate limits, no Dev Mode plan required.",
  "keywords": [
    "figma",
    "figma-api",
    "scraper",
    "design-tokens",
    "playwright"
  ],
  "homepage": "https://github.com/dryor/figtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dryor/figtools.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dryor/figtools/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
