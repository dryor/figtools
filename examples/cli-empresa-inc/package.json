{
  "name": "cli-empresa-inc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "fetch:json": "figtools \"https://www.figma.com/design/HThrmBFcF8JMNq4q6d8C4T/Empresa-Inc.\" --format json --output ./empresa-inc/json",
    "fetch:markdown": "figtools \"https://www.figma.com/design/HThrmBFcF8JMNq4q6d8C4T/Empresa-Inc.\" --format markdown --output ./empresa-inc/markdown",
    "fetch": "pnpm run fetch:json && pnpm run fetch:markdown"
  },
  "dependencies": {
    "@figtools/cli": "workspace:*"
  }
}
